{
  "name": "aruodore",
  "private": true,
  "type": "module",
  "scripts": {
    "audit:dependencies": "node scripts/audit-dependencies.mjs",
    "audit:filenames": "node scripts/audit-filenames.mjs",
    "audit:production": "node scripts/audit-production.mjs",
    "build": "nuxt build",
    "dev": "nuxt dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate": "nuxt generate",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "test:accessibility": "playwright test --grep @accessibility",
    "test:component": "vitest run tests/component",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --grep-invert @visual",
    "test:e2e:ui": "playwright test --ui",
    "test:integration": "vitest run tests/integration",
    "test:performance": "node scripts/run-lighthouse.mjs",
    "test:unit": "vitest run tests/unit",
    "test:visual": "playwright test --grep @visual",
    "typecheck": "nuxt typecheck",
    "verify": "npm run audit:filenames && npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run generate && npm run audit:production && git diff --check"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/stix-two-text": "^5.3.0",
    "@nuxt/content": "^3.0.0",
    "@types/three": "^0.184.1",
    "katex": "^0.16.11",
    "nuxt": "^3.13.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "three": "^0.185.1",
    "vue": "^3.5.0",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@nuxt/test-utils": "^4.1.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/katex": "^0.16.7",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "better-sqlite3": "^12.10.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "eslint-plugin-vue": "^10.10.0",
    "happy-dom": "^20.11.1",
    "knip": "^6.31.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^2.1.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "better-sqlite3@12.10.0": true,
    "esbuild@0.28.0": true,
    "esbuild@0.27.7": true
  }
}
